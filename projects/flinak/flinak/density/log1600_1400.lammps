
#-----------------------------------------------------------------------------
#----------------------------- Output Settings -------------------------------
#-----------------------------------------------------------------------------
thermo_style custom step etotal pe ke temp enthalpy vol press density
dump force all custom 100 lammps${T1}_${T2}.dump id type x y z vx vy vz
dump force all custom 100 lammps1600_${T2}.dump id type x y z vx vy vz
dump force all custom 100 lammps1600_1400.dump id type x y z vx vy vz
dump_modify force sort id

#-----------------------------------------------------------------------------
#--------------------------- Equilibration run -------------------------------
#-----------------------------------------------------------------------------
velocity all create ${T1} 123456 dist gaussian
velocity all create 1600 123456 dist gaussian
fix 1 all npt temp ${T1} ${T2} 0.1 iso 0 $P 1
fix 1 all npt temp 1600 ${T2} 0.1 iso 0 $P 1
fix 1 all npt temp 1600 1400 0.1 iso 0 $P 1
fix 1 all npt temp 1600 1400 0.1 iso 0 0 1
run 30000
