LAMMPS (23 Jun 2022)
OMP_NUM_THREADS environment is not set. Defaulting to 1 thread. (../comm.cpp:98)
  using 1 OpenMP thread(s) per MPI task
#-----------------------------------------------------------------------------
#----------------------------- General setting -------------------------------
#-----------------------------------------------------------------------------
clear
OMP_NUM_THREADS environment is not set. Defaulting to 1 thread. (../comm.cpp:98)
  using 1 OpenMP thread(s) per MPI task
units metal
dimension 3
boundary p p p
atom_style atomic
variable    T equal 800
variable    V equal vol
variable    dt equal 0.001
variable    p equal 20000   # correlation length  (or Nrepeat)
variable    s equal 1       # sample interval     (or Nevery)
variable    d equal $p*$s   # dump interval       (or Nfreq)
variable    d equal 20000*$s   
variable    d equal 20000*1   

# convert from LAMMPS real units to SI

variable    kB equal 1.3806504e-23    # [J/K] Boltzmann
variable    bar2Pa equal 100000.0
variable    A2m equal 1.0e-10
variable    ps2s equal 1.0e-12
variable    convert equal ${bar2Pa}*${bar2Pa}*${ps2s}*${A2m}*${A2m}*${A2m}
variable    convert equal 100000*${bar2Pa}*${ps2s}*${A2m}*${A2m}*${A2m}
variable    convert equal 100000*100000*${ps2s}*${A2m}*${A2m}*${A2m}
variable    convert equal 100000*100000*1e-12*${A2m}*${A2m}*${A2m}
variable    convert equal 100000*100000*1e-12*1e-10*${A2m}*${A2m}
variable    convert equal 100000*100000*1e-12*1e-10*1e-10*${A2m}
variable    convert equal 100000*100000*1e-12*1e-10*1e-10*1e-10

#-----------------------------------------------------------------------------
#---------------------------- Importing atoms --------------------------------
#-----------------------------------------------------------------------------
read_data cubic400.data
Reading data file ...
  orthogonal box = (4.1844066 5.0243022 4.1908196) to (22.639783 25.586258 22.862247)
  3 by 4 by 3 MPI processor grid
  reading atoms ...
  400 atoms
  read_data CPU = 0.021 seconds

#-----------------------------------------------------------------------------
#------------------------- Interatomic Potential -----------------------------
#-----------------------------------------------------------------------------
pair_style mlip mlip.ini
pair_coeff * *

#-----------------------------------------------------------------------------
#----------------------------- Other Settings --------------------------------
#-----------------------------------------------------------------------------
neighbor 2.0 bin
neigh_modify delay 1 check yes

timestep     ${dt}
timestep     0.001
thermo       $d
thermo       20000

#-----------------------------------------------------------------------------
#--------------------------- Equilibration run -------------------------------
#-----------------------------------------------------------------------------

velocity     all create 1300 102486 mom yes rot yes dist gaussian
fix          NPT all npt temp 1300 $T 0.1 iso 0 0 1 drag 1
fix          NPT all npt temp 1300 800 0.1 iso 0 0 1 drag 1
run          30000
