#-----------------------------------------------------------------------------
#----------------------------- Production run --------------------------------
#-----------------------------------------------------------------------------

fix         NVE all nve

reset_timestep 0
variable     pxy equal pxy
variable     pxz equal pxz
variable     pyz equal pyz
fix          SS all ave/correlate $s $p $d              v_pxy v_pxz v_pyz type auto file S0St700.dat ave running
fix          SS all ave/correlate 1 $p $d              v_pxy v_pxz v_pyz type auto file S0St700.dat ave running
fix          SS all ave/correlate 1 20000 $d              v_pxy v_pxz v_pyz type auto file S0St700.dat ave running
fix          SS all ave/correlate 1 20000 20000              v_pxy v_pxz v_pyz type auto file S0St700.dat ave running
variable     scale equal ${convert}/(${kB}*$T)*$V*$s*${dt}
variable     scale equal 1e-32/(${kB}*$T)*$V*$s*${dt}
variable     scale equal 1e-32/(1.3806504e-23*$T)*$V*$s*${dt}
variable     scale equal 1e-32/(1.3806504e-23*800)*$V*$s*${dt}
variable     scale equal 1e-32/(1.3806504e-23*800)*6572.3022101678*$s*${dt}
variable     scale equal 1e-32/(1.3806504e-23*800)*6572.3022101678*1*${dt}
variable     scale equal 1e-32/(1.3806504e-23*800)*6572.3022101678*1*0.001
variable     v11 equal trap(f_SS[3])*${scale}
variable     v11 equal trap(f_SS[3])*5.95036785757622e-12
variable     v22 equal trap(f_SS[4])*${scale}
variable     v22 equal trap(f_SS[4])*5.95036785757622e-12
variable     v33 equal trap(f_SS[5])*${scale}
variable     v33 equal trap(f_SS[5])*5.95036785757622e-12
thermo_style custom step temp press v_pxy v_pxz v_pyz v_v11 v_v22 v_v33
run          5000000
